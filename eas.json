{
  "cli": {
    "version": ">= 18.9.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_OPEN_STREET_MAP_URL": "https://nominatim.openstreetmap.org",
        "EXPO_PUBLIC_GOOGLE_MAPS_API_URL": "https://maps.googleapis.com/maps/api",
        "EXPO_PUBLIC_ROADOM_TRIP_API_URL": "https://aleacarta-api.vercel.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_OPEN_STREET_MAP_URL": "https://nominatim.openstreetmap.org",
        "EXPO_PUBLIC_GOOGLE_MAPS_API_URL": "https://maps.googleapis.com/maps/api",
        "EXPO_PUBLIC_ROADOM_TRIP_API_URL": "https://aleacarta-api.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
